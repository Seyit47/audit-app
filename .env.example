# PostgreSQL connection for local development.
# Docker Compose: postgresql://audit:audit@localhost:5432/audit_dev
DATABASE_URL=
# Separate database used by integration and contract tests (wiped by tests).
DATABASE_URL_TEST=
# Port the API listens on.
PORT=3000
# development | staging | production
APP_ENV=development
# pino log level: fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Mobile clients below this version get 426 CLIENT_UPDATE_REQUIRED.
MIN_MOBILE_VERSION=0.1.0
# Minimum supported admin web version, reported by /v1/version.
MIN_ADMIN_WEB_VERSION=0.1.0
# Base URL the admin web app uses to reach the API.
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
