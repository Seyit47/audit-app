{
  "version": 8,
  "name": "Audit (Figma 21:2 palette)",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#f3f2ff" } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#d7e3ff", "fill-opacity": 0.5 } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#d7e3ff", "line-opacity": 0.5, "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 6] } },
    { "id": "boundary", "type": "line", "source": "openmaptiles", "source-layer": "boundary",
      "filter": ["<=", ["get", "admin_level"], 8],
      "paint": { "line-color": "#c7c4d8", "line-width": 1.44, "line-dasharray": [4, 3] } },
    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["minor", "service", "track", "path"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffffff", "line-opacity": 0.85, "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 3.84] } },
    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ededfb", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 7.68] } },
    { "id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 16, 11.52] } },
    { "id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name",
      "minzoom": 14,
      "layout": { "symbol-placement": "line", "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11 },
      "paint": { "text-color": "#777587", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5 } },
    { "id": "place-label", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["match", ["get", "class"], ["city", "town", "suburb", "neighbourhood"], true, false],
      "layout": { "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 13] },
      "paint": { "text-color": "#464555", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5 } }
  ]
}
