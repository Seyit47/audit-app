{
  "version": 8,
  "name": "Audit (Figma 21:2 palette)",
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "sources": {
    "openmaptiles": {
      "type": "vector",
      "url": "https://tiles.openfreemap.org/planet"
    }
  },
  "layers": [
    {"id": "background", "type": "background", "paint": {"background-color": "#f3f2ff"}},
    {"id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["!", ["match", ["get", "class"], ["hospital", "school", "university", "college", "kindergarten", "stadium", "cemetery", "military"], true, false]], "paint": {"fill-color": "#ecebfb", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 10, 0, 12, 1]}},
    {"id": "landuse-institution", "type": "fill", "source": "openmaptiles", "source-layer": "landuse", "filter": ["match", ["get", "class"], ["hospital", "school", "university", "college", "kindergarten", "stadium", "cemetery", "military"], true, false], "paint": {"fill-color": "#e6e2f8", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0, 13, 1]}},
    {"id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park", "paint": {"fill-color": "#e3efe6"}},
    {"id": "landcover-green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["match", ["get", "class"], ["grass", "wood"], true, false], "paint": {"fill-color": "#e3efe6", "fill-opacity": 0.7}},
    {"id": "landcover-farmland", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "farmland"], "paint": {"fill-color": "#ebeff0", "fill-opacity": 0.8}},
    {"id": "landcover-sand", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "sand"], "paint": {"fill-color": "#f6f1e6", "fill-opacity": 0.8}},
    {"id": "landcover-wetland", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "wetland"], "paint": {"fill-color": "#e0eef0", "fill-opacity": 0.8}},
    {"id": "landcover-rock", "type": "fill", "source": "openmaptiles", "source-layer": "landcover", "filter": ["==", ["get", "class"], "rock"], "paint": {"fill-color": "#e8e7ef", "fill-opacity": 0.8}},
    {"id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water", "paint": {"fill-color": "#d7e3ff", "fill-opacity": 0.5}},
    {"id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway", "paint": {"line-color": "#d7e3ff", "line-opacity": 0.5, "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 6]}},
    {"id": "boundary", "type": "line", "source": "openmaptiles", "source-layer": "boundary", "filter": ["<=", ["get", "admin_level"], 8], "paint": {"line-color": "#c7c4d8", "line-width": 1.44, "line-dasharray": [4, 3]}},
    {"id": "aeroway-area", "type": "fill", "source": "openmaptiles", "source-layer": "aeroway", "minzoom": 10, "filter": ["==", ["geometry-type"], "Polygon"], "paint": {"fill-color": "#e9e7f8"}},
    {"id": "aeroway-runway", "type": "line", "source": "openmaptiles", "source-layer": "aeroway", "minzoom": 10, "filter": ["all", ["==", ["geometry-type"], "LineString"], ["match", ["get", "class"], ["runway", "taxiway"], true, false]], "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 12]}},
    {"id": "building", "type": "fill", "source": "openmaptiles", "source-layer": "building", "minzoom": 13, "paint": {"fill-color": "#e4e2f6", "fill-outline-color": "#d9d6ee", "fill-opacity": ["interpolate", ["linear"], ["zoom"], 13, 0, 14, 1]}},
    {"id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["minor", "service", "track", "path", "pier", "bridge", "raceway", "busway", "bus_guideway"], true, false], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#ffffff", "line-opacity": 0.85, "line-width": ["interpolate", ["linear"], ["zoom"], 12, 0.5, 16, 3.84]}},
    {"id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["secondary", "tertiary"], true, false], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#ededfb", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 16, 7.68]}},
    {"id": "road-major", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "filter": ["match", ["get", "class"], ["motorway", "trunk", "primary"], true, false], "layout": {"line-cap": "round", "line-join": "round"}, "paint": {"line-color": "#ffffff", "line-width": ["interpolate", ["linear"], ["zoom"], 8, 1.5, 16, 11.52]}},
    {"id": "railway", "type": "line", "source": "openmaptiles", "source-layer": "transportation", "minzoom": 9, "filter": ["match", ["get", "class"], ["rail", "transit"], true, false], "paint": {"line-color": "#bdbad0", "line-width": ["interpolate", ["linear"], ["zoom"], 9, 1, 16, 2.5], "line-dasharray": [3, 2]}},
    {"id": "water-label", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "layout": {"text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 12, "text-max-width": 8}, "paint": {"text-color": "#6f86b8", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}, "filter": ["==", ["geometry-type"], "Point"]},
    {"id": "water-label-line", "type": "symbol", "source": "openmaptiles", "source-layer": "water_name", "layout": {"text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 12, "text-max-width": 8, "symbol-placement": "line"}, "paint": {"text-color": "#6f86b8", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}, "filter": ["==", ["geometry-type"], "LineString"]},
    {"id": "housenumber", "type": "symbol", "source": "openmaptiles", "source-layer": "housenumber", "minzoom": 16, "layout": {"text-field": ["get", "housenumber"], "text-font": ["Noto Sans Regular"], "text-size": 10}, "paint": {"text-color": "#9a98ab", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}},
    {"id": "poi-dot", "type": "circle", "source": "openmaptiles", "source-layer": "poi", "minzoom": 14, "filter": ["has", "name"], "paint": {"circle-radius": 3, "circle-color": "#8f8ca6", "circle-stroke-color": "#f3f2ff", "circle-stroke-width": 1}},
    {"id": "poi-label", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "minzoom": 14, "filter": ["has", "name"], "layout": {"text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-max-width": 8, "text-anchor": "top", "text-offset": [0, 0.5], "symbol-sort-key": ["get", "rank"]}, "paint": {"text-color": "#777587", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}},
    {"id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 13, "layout": {"symbol-placement": "line", "text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11}, "paint": {"text-color": "#777587", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}},
    {"id": "airport-label", "type": "symbol", "source": "openmaptiles", "source-layer": "aerodrome_label", "minzoom": 10, "layout": {"text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 12, "text-max-width": 8}, "paint": {"text-color": "#777587", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}},
    {"id": "peak-label", "type": "symbol", "source": "openmaptiles", "source-layer": "mountain_peak", "minzoom": 11, "filter": ["has", "name"], "layout": {"text-field": ["concat", ["coalesce", ["get", "name:latin"], ["get", "name"]], "\n", ["to-string", ["get", "ele"]], " m"], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-max-width": 8}, "paint": {"text-color": "#777587", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}},
    {"id": "place-minor", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["match", ["get", "class"], ["village", "hamlet", "quarter", "isolated_dwelling", "locality"], true, false], "layout": {"text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 10, 10, 15, 12]}, "paint": {"text-color": "#464555", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}, "minzoom": 10},
    {"id": "place-state", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["==", ["get", "class"], "state"], "layout": {"text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": 11, "text-transform": "uppercase", "text-letter-spacing": 0.08}, "paint": {"text-color": "#464555", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5, "text-opacity": 0.7}, "maxzoom": 9},
    {"id": "place-label", "type": "symbol", "source": "openmaptiles", "source-layer": "place", "filter": ["match", ["get", "class"], ["city", "town", "suburb", "neighbourhood"], true, false], "layout": {"text-field": ["coalesce", ["get", "name:latin"], ["get", "name"]], "text-font": ["Noto Sans Regular"], "text-size": ["interpolate", ["linear"], ["zoom"], 8, 12, 14, 13]}, "paint": {"text-color": "#464555", "text-halo-color": "#f3f2ff", "text-halo-width": 1.5}}
  ]
}
