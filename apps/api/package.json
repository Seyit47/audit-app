{
  "type": "module",
  "name": "api",
  "version": "1.0.0",
  "description": "This project was bootstrapped with Fastify-CLI.",
  "main": "app.ts",
  "directories": {
    "test": "test"
  },
  "scripts": {
    "test": "npm run build:ts && tsc -p test/tsconfig.json && FASTIFY_AUTOLOAD_TYPESCRIPT=1 node --test --experimental-test-coverage --loader ts-node/esm test/**/*.ts",
    "clean": "node -e \"require('fs').rmSync('dist', {recursive: true, force: true})\"",
    "start": "npm run build:ts && fastify start -l info dist/app.js",
    "build:ts": "npm run clean && tsc",
    "watch:ts": "tsc -w",
    "dev": "fastify start -w -l info src/app.ts"
  },
  "keywords": [],
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1146.0",
    "@aws-sdk/s3-request-presigner": "^3.1146.0",
    "@fastify/autoload": "^6.0.0",
    "@fastify/cors": "^11.3.0",
    "@fastify/jwt": "^10.2.2",
    "@fastify/rate-limit": "^11.2.0",
    "@fastify/sensible": "^6.0.0",
    "@fastify/swagger": "^9.9.1",
    "@fastify/swagger-ui": "^6.1.1",
    "@fastify/type-provider-typebox": "^6.1.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@sinclair/typebox": "^0.34.52",
    "argon2": "^0.45.1",
    "dotenv": "^18.0.5",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "fastify-cli": "^8.0.3",
    "fastify-plugin": "^6.0.0",
    "pdfmake": "^0.3.11",
    "pg-boss": "^12.36.0",
    "sharp": "^0.35.5",
    "uuid": "^14.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.0.0",
    "@types/pdfmake": "^0.3.3",
    "c8": "^12.0.0",
    "concurrently": "^10.0.1",
    "eslint": "^9.39.5",
    "fastify-tsconfig": "^3.0.0",
    "prisma": "^7.10.0",
    "ts-node": "^10.4.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.71.0"
  }
}
