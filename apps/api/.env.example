# PostgreSQL 16. Tests use DATABASE_URL_TEST when set.
DATABASE_URL=postgresql://audit:CHANGE_ME@localhost:5432/audit
# DATABASE_URL_TEST=postgresql://audit:CHANGE_ME@localhost:5432/audit_test

# At least 32 random characters: openssl rand -base64 48
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_OF_32_PLUS_CHARS

# S3-compatible storage (SeaweedFS in compose). The bucket is created on start.
S3_ENDPOINT=http://localhost:8333
S3_BUCKET=audit-photos
# S3_BUCKET_TEST=audit-photos-test
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# The provider's region: `auto` for Cloudflare R2, e.g. `eu-central-003` for Backblaze B2; unset for SeaweedFS.
# S3_REGION=auto

# The admin web origin(s), comma-separated: the only browser origins CORS allows.
WEB_ORIGIN=http://localhost:3002

# Optional
# RETENTION_YEARS=3            # location pings and export files older than this are purged nightly (audits and photos are kept)
# CURRENCY=TMT
# JOBS_DISABLED=1              # run the API without the pg-boss workers (operator CLIs set it)
